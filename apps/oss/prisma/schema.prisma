generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth Core Models ──

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ── Organization Models ──

model Organization {
  id                      String                  @id
  name                    String
  slug                    String                  @unique
  logo                    String?
  metadata                String?
  createdAt               DateTime
  stripeCustomerId        String?                 @unique
  stripeSubscriptionId    String?
  stripePriceId           String?
  subscriptionStatus      String?                 @default("free")
  members                 Member[]
  invitations             Invitation[]
  contacts                Contact[]
  catalogItems            CatalogItem[]
  taxIds                  OrganizationTaxId[]
  invoices                Invoice[]
  agreements              Agreement[]
  agreementTemplates      AgreementTemplate[]
  quotes                  Quote[]
  creditNotes             CreditNote[]
  payments                Payment[]
  recurringInvoices       RecurringInvoice[]
  domainEvents            DomainEvent[]
  eventConsumerCursors    EventConsumerCursor[]
  eventConsumerDeliveries EventConsumerDelivery[]
  agentKeys               AgentKey[]
  approvalRequests        ApprovalRequest[]
  schedulerScans          SchedulerScan[]
  settings                OrgSettings?

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime

  @@index([organizationId])
  @@index([inviterId])
  @@map("invitation")
}

// ── App Models ──

model InstallationState {
  id              String   @id @default("default")
  isSetupComplete Boolean  @default(false)
  distribution    String   @default("selfhost")
  setupVersion    Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("installation_state")
}

model OrgSettings {
  id                                 String       @id @default(cuid())
  organizationId                     String       @unique
  organization                       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  countryCode                        String       @default("US")
  locale                             String       @default("en-US")
  timezone                           String       @default("UTC")
  defaultCurrency                    String       @default("USD")
  taxRegime                          String       @default("us_sales_tax")
  pricesIncludeTax                   Boolean      @default(false)
  currency                           String       @default("USD")
  taxRate                            Decimal?     @db.Decimal(5, 2)
  companyName                        String?
  companyAddress                     String?
  companyEmail                       String?
  companyPhone                       String?
  companyLogo                        String?
  invoicePrefix                      String       @default("INV")
  invoiceNextNum                     Int          @default(1)
  agreementPrefix                    String       @default("AGR")
  agreementNextNum                   Int          @default(1)
  quotePrefix                        String       @default("QTE")
  quoteNextNum                       Int          @default(1)
  creditNotePrefix                   String       @default("CN")
  creditNoteNextNum                  Int          @default(1)
  reminderPolicy                     Json?
  eventSequence                      Int          @default(0)
  onboardingStatus                   String       @default("not_started")
  onboardingMethod                   String?
  onboardingProfile                  String?
  onboardingInvoicingIdentity        String?
  onboardingVersion                  Int?
  onboardingCompletedAt              DateTime?
  aiOpenRouterApiKeyEnc              String?
  aiOpenRouterModel                  String       @default("openai/gpt-4o-mini")
  stripePublishableKey               String?
  stripeSecretKeyEnc                 String?
  stripeWebhookSecretEnc             String?
  documentSendingDomain              String?
  documentSendingDomainProviderId    String?
  documentSendingDomainStatus        String?
  documentSendingDomainRecords       Json?
  documentSendingDomainFailureReason String?
  documentSendingDomainVerifiedAt    DateTime?
  documentSendingLastSyncedAt        DateTime?
  documentSendingLastSyncSource      String?
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime     @updatedAt

  @@index([onboardingStatus])
  @@index([onboardingCompletedAt])
  @@map("org_settings")
}

model Contact {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  company              String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  country              String?
  taxId                String?
  taxIds               ContactTaxId[]
  peppolEndpointId     String?
  peppolEndpointScheme String?
  notes                String?
  invoices             Invoice[]
  agreements           Agreement[]
  quotes               Quote[]
  creditNotes          CreditNote[]
  recurringInvoices    RecurringInvoice[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@map("contact")
}

model CatalogItem {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  defaultUnitPrice Decimal      @db.Decimal(12, 2)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("catalog_item")
}

model OrganizationTaxId {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheme         String
  value          String
  countryCode    String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, scheme])
  @@map("organization_tax_id")
}

model ContactTaxId {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  scheme      String
  value       String
  countryCode String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contactId])
  @@index([contactId, scheme])
  @@map("contact_tax_id")
}

model Invoice {
  id                      String            @id @default(cuid())
  organizationId          String
  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId               String
  contact                 Contact           @relation(fields: [contactId], references: [id])
  number                  String
  status                  String            @default("draft")
  issueDate               DateTime          @default(now())
  dueDate                 DateTime
  supplyDate              DateTime?
  subtotalNet             Decimal           @db.Decimal(12, 2)
  totalTax                Decimal           @default(0) @db.Decimal(12, 2)
  totalGross              Decimal           @db.Decimal(12, 2)
  currency                String            @default("USD")
  countryCode             String            @default("US")
  locale                  String            @default("en-US")
  timezone                String            @default("UTC")
  taxRegime               String            @default("us_sales_tax")
  pricesIncludeTax        Boolean           @default(false)
  sellerSnapshot          Json?
  buyerSnapshot           Json?
  complianceStatus        String            @default("valid")
  complianceErrors        Json?
  legalText               Json?
  paymentStatus           String            @default("unpaid")
  paidAt                  DateTime?
  publicPaymentIssuedAt   DateTime?
  publicPaymentKeyVersion Int               @default(1)
  lastEmailAttemptAt      DateTime?
  lastEmailAttemptOutcome String?
  lastEmailAttemptCode    String?
  lastEmailAttemptMessage String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paymentFailureReason    String?
  paymentReference        String?
  purchaseOrderRef        String?
  einvoiceFormat          String?
  einvoiceStatus          String?
  einvoiceExternalId      String?
  notes                   String?
  amountPaid              Decimal           @default(0) @db.Decimal(12, 2)
  amountCredited          Decimal           @default(0) @db.Decimal(12, 2)
  remindersPaused         Boolean           @default(false)
  items                   InvoiceItem[]
  payments                Payment[]
  creditNotes             CreditNote[]
  reminders               InvoiceReminder[]
  quoteId                 String?
  quote                   Quote?            @relation(fields: [quoteId], references: [id])
  recurringInvoiceId      String?
  recurringInvoice        RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  recurringRunDate        DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  calculationVersion String @default("legacy_per_line")
  vatEvidence        Json?

  @@unique([organizationId, number])
  @@unique([recurringInvoiceId, recurringRunDate])
  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, publicPaymentIssuedAt])
  @@index([organizationId, dueDate])
  @@map("invoice")
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unitPriceNet   Decimal @db.Decimal(12, 2)
  unitPriceGross Decimal @db.Decimal(12, 2)
  lineNet        Decimal @db.Decimal(12, 2)
  lineTax        Decimal @default(0) @db.Decimal(12, 2)
  lineGross      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  taxCategory    String  @default("standard")
  taxCode        String?
  sortOrder      Int     @default(0)

  vatTreatment   String  @default("standard")
  vatCountry     String?
  vatReasonCode  String?
  quantityInput  String?
  unitPriceInput String?
  inputPrecision String?

  @@index([invoiceId])
  @@map("invoice_item")
}

model Quote {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId               String
  contact                 Contact      @relation(fields: [contactId], references: [id])
  number                  String
  status                  String       @default("draft")
  issueDate               DateTime     @default(now())
  expiryDate              DateTime
  supplyDate              DateTime?
  subtotalNet             Decimal      @db.Decimal(12, 2)
  totalTax                Decimal      @default(0) @db.Decimal(12, 2)
  totalGross              Decimal      @db.Decimal(12, 2)
  currency                String       @default("USD")
  countryCode             String       @default("US")
  locale                  String       @default("en-US")
  timezone                String       @default("UTC")
  taxRegime               String       @default("us_sales_tax")
  pricesIncludeTax        Boolean      @default(false)
  sellerSnapshot          Json?
  buyerSnapshot           Json?
  complianceStatus        String       @default("valid")
  complianceErrors        Json?
  legalText               Json?
  purchaseOrderRef        String?
  paymentReference        String?
  publicAccessKeyVersion  Int          @default(1)
  publicAccessIssuedAt    DateTime?
  publicDecisionAt        DateTime?
  publicRejectionReason   String?
  lastEmailAttemptAt      DateTime?
  lastEmailAttemptOutcome String?
  lastEmailAttemptCode    String?
  lastEmailAttemptMessage String?
  notes                   String?
  items                   QuoteItem[]
  invoices                Invoice[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  calculationVersion String @default("legacy_per_line")
  vatEvidence        Json?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, status])
  @@index([organizationId, publicDecisionAt])
  @@map("quote")
}

model QuoteItem {
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unitPriceNet   Decimal @db.Decimal(12, 2)
  unitPriceGross Decimal @db.Decimal(12, 2)
  lineNet        Decimal @db.Decimal(12, 2)
  lineTax        Decimal @default(0) @db.Decimal(12, 2)
  lineGross      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  taxCategory    String  @default("standard")
  taxCode        String?
  sortOrder      Int     @default(0)

  vatTreatment   String  @default("standard")
  vatCountry     String?
  vatReasonCode  String?
  quantityInput  String?
  unitPriceInput String?
  inputPrecision String?

  @@index([quoteId])
  @@map("quote_item")
}

model CreditNote {
  id                      String           @id @default(cuid())
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId               String
  invoice                 Invoice          @relation(fields: [invoiceId], references: [id])
  contactId               String
  contact                 Contact          @relation(fields: [contactId], references: [id])
  number                  String
  status                  String           @default("issued")
  reason                  String
  issueDate               DateTime         @default(now())
  subtotalNet             Decimal          @db.Decimal(12, 2)
  totalTax                Decimal          @default(0) @db.Decimal(12, 2)
  totalGross              Decimal          @db.Decimal(12, 2)
  currency                String
  countryCode             String
  locale                  String
  timezone                String
  taxRegime               String
  pricesIncludeTax        Boolean          @default(false)
  sellerSnapshot          Json?
  buyerSnapshot           Json?
  notes                   String?
  lastEmailAttemptAt      DateTime?
  lastEmailAttemptOutcome String?
  lastEmailAttemptCode    String?
  lastEmailAttemptMessage String?
  items                   CreditNoteItem[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  calculationVersion String @default("legacy_per_line")
  vatEvidence        Json?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, issueDate])
  @@map("credit_note")
}

model CreditNoteItem {
  id             String     @id @default(cuid())
  creditNoteId   String
  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceItemId  String?
  description    String
  quantity       Decimal    @db.Decimal(10, 2)
  unitPriceNet   Decimal    @db.Decimal(12, 2)
  unitPriceGross Decimal    @db.Decimal(12, 2)
  lineNet        Decimal    @db.Decimal(12, 2)
  lineTax        Decimal    @default(0) @db.Decimal(12, 2)
  lineGross      Decimal    @db.Decimal(12, 2)
  taxRate        Decimal    @db.Decimal(5, 2)
  taxCategory    String     @default("standard")
  taxCode        String?
  sortOrder      Int        @default(0)

  vatTreatment   String  @default("standard")
  vatCountry     String?
  vatReasonCode  String?
  quantityInput  String?
  unitPriceInput String?
  inputPrecision String?

  @@index([creditNoteId])
  @@map("credit_note_item")
}

model Payment {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId               String
  invoice                 Invoice      @relation(fields: [invoiceId], references: [id])
  amount                  Decimal      @db.Decimal(12, 2)
  currency                String
  paidAt                  DateTime
  method                  String
  reference               String?
  note                    String?
  source                  String
  stripeCheckoutSessionId String?      @unique
  stripePaymentIntentId   String?
  voidedAt                DateTime?
  voidReason              String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, paidAt])
  @@map("payment")
}

model InvoiceReminder {
  id             String    @id @default(cuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  offsetDays     Int
  scheduledFor   DateTime
  sentAt         DateTime?
  outcome        String?
  outcomeMessage String?
  createdAt      DateTime  @default(now())

  @@unique([invoiceId, offsetDays])
  @@index([sentAt, scheduledFor])
  @@map("invoice_reminder")
}

model RecurringInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  name           String
  status         String       @default("active")
  intervalCount  Int          @default(1)
  intervalUnit   String       @default("month")
  startDate      DateTime
  nextRunAt      DateTime
  endsAt         DateTime?
  remainingRuns  Int?
  dueInDays      Int          @default(14)
  autoSend       Boolean      @default(false)
  currency       String
  taxRate        Decimal      @db.Decimal(5, 2)
  notes          String?
  items          Json
  lastRunAt      DateTime?
  invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status, nextRunAt])
  @@map("recurring_invoice")
}

model DomainEvent {
  schemaVersion    Int          @default(1)
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequence         Int
  aggregateType    String
  aggregateId      String
  type             String
  payload          Json
  actorKind        String
  actorId          String?
  actorLabel       String?
  approvedByUserId String?
  commandId        String?
  occurredAt       DateTime     @default(now())

  @@unique([organizationId, sequence])
  @@index([organizationId, aggregateType, aggregateId])
  @@map("domain_event")
}

model CommandReceipt {
  id              String   @id @default(cuid())
  organizationId  String
  actorKey        String
  clientRequestId String
  commandType     String
  status          String
  result          Json?
  error           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, actorKey, clientRequestId])
  @@map("command_receipt")
}

model ApprovalRequest {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentKeyId       String
  agentKey         AgentKey     @relation(fields: [agentKeyId], references: [id], onDelete: Cascade)
  commandReceiptId String       @unique
  commandType      String
  command          Json
  summary          String
  /// What the person approving saw: document details and a version the command must still match.
  reviewContext    Json?
  status           String       @default("pending")
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionNote     String?
  expiresAt        DateTime
  createdAt        DateTime     @default(now())

  @@index([organizationId, status])
  @@map("approval_request")
}

model AgentKey {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  mode             String            @default("approval_required")
  scopes           String[]
  secretHash       String            @unique
  displayPrefix    String
  createdByUserId  String
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  approvalRequests ApprovalRequest[]
  createdAt        DateTime          @default(now())

  @@index([organizationId])
  @@map("agent_key")
}

model Job {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  status         String   @default("pending")
  attempts       Int      @default(0)
  runAfter       DateTime @default(now())
  lastError      String?
  /// What the job settled as, for handlers that record an outcome (e.g. email delivery).
  result         Json?
  /// Identifies the run that holds a `running` job; cleared when it leaves `running`.
  claimToken     String?
  dedupeKey      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, runAfter])
  @@map("job")
}

/// When a scheduler task last claimed an organization; ticks claim the least recently scanned.
/// A tick holding an organization stamps `claimToken` and `claimedUntil`; other ticks skip it
/// until the claim is finished, released or expires.
model SchedulerScan {
  task           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scannedAt      DateTime?
  claimToken     String?
  claimedUntil   DateTime?

  @@id([task, organizationId])
  @@index([task, scannedAt])
  @@index([organizationId])
  @@map("scheduler_scan")
}

model Agreement {
  id                      String             @id @default(cuid())
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId               String
  contact                 Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  number                  String?
  status                  String             @default("draft")
  title                   String
  summary                 String?
  termsMarkdown           String
  templateId              String?
  template                AgreementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  taxRate                 Decimal            @default(0) @db.Decimal(5, 2)
  currency                String             @default("USD")
  countryCode             String             @default("US")
  locale                  String             @default("en-US")
  timezone                String             @default("UTC")
  taxRegime               String             @default("us_sales_tax")
  pricesIncludeTax        Boolean            @default(false)
  dueInDays               Int                @default(30)
  billingTrigger          String             @default("on_acceptance")
  subtotalNet             Decimal            @db.Decimal(12, 2)
  totalTax                Decimal            @default(0) @db.Decimal(12, 2)
  totalGross              Decimal            @db.Decimal(12, 2)
  sellerSnapshot          Json?
  buyerSnapshot           Json?
  validUntil              DateTime           @db.Date
  issueDate               DateTime?
  expiresAt               DateTime?
  offerRevision           Int                @default(0)
  offerSnapshot           Json?
  offerSnapshotHash       String?
  issuedToEmail           String?
  issuedVia               String?
  publicAccessKeyVersion  Int                @default(1)
  publicAccessIssuedAt    DateTime?
  lastEmailAttemptAt      DateTime?
  lastEmailAttemptOutcome String?
  lastEmailAttemptCode    String?
  lastEmailAttemptMessage String?
  acceptedAt              DateTime?
  acceptedOfferRevision   Int?
  acceptedByName          String?
  acceptanceIp            String?
  acceptanceUserAgent     String?
  acceptanceMethod        String?
  acceptanceEvidenceNote  String?
  declinedAt              DateTime?
  declineReason           String?
  closedAt                DateTime?
  closeReason             String?
  notes                   String?
  deliverables            Deliverable[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  calculationVersion String @default("legacy_per_line")
  vatEvidence        Json?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([contactId])
  @@map("agreement")
}

model Deliverable {
  id                     String    @id @default(cuid())
  agreementId            String
  agreement              Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  title                  String
  description            String
  quantity               Decimal   @db.Decimal(10, 2)
  unitPriceNet           Decimal   @db.Decimal(12, 2)
  unitPriceGross         Decimal   @db.Decimal(12, 2)
  lineNet                Decimal   @db.Decimal(12, 2)
  lineTax                Decimal   @default(0) @db.Decimal(12, 2)
  lineGross              Decimal   @db.Decimal(12, 2)
  taxRate                Decimal   @db.Decimal(5, 2)
  taxCategory            String    @default("standard")
  taxCode                String?
  agreedDate             DateTime? @db.Date
  expectedDate           DateTime? @db.Date
  isDeposit              Boolean   @default(false)
  status                 String    @default("planned")
  billingStatus          String    @default("unbilled")
  deliveryRevision       Int       @default(0)
  deliveredAt            DateTime?
  acceptedAt             DateTime?
  acceptedRevision       Int?
  acceptedVia            String?
  acceptanceEvidenceNote String?
  changeRequestNote      String?
  sortOrder              Int       @default(0)

  vatTreatment   String  @default("standard")
  vatCountry     String?
  vatReasonCode  String?
  quantityInput  String?
  unitPriceInput String?
  inputPrecision String?

  @@index([agreementId])
  @@map("deliverable")
}

model AgreementTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  termsMarkdown  String
  isDefault      Boolean      @default(false)
  agreements     Agreement[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@map("agreement_template")
}

// Attempts have no document FK so deleted drafts do not erase abuse counters.
model PublicLinkAttempt {
  id           String   @id @default(cuid())
  documentKind String
  documentId   String
  scope        String
  keyVersion   Int
  targetId     String?
  revision     Int
  createdAt    DateTime @default(now())

  @@index([documentKind, documentId, scope, keyVersion, targetId, revision, createdAt])
  @@index([createdAt])
  @@map("public_link_attempt")
}

enum EventConsumerDeliveryStatus {
  pending
  claimed
  done
  failed
  skipped
}

model EventConsumerCursor {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consumerKey          String
  acknowledgedSequence Int          @default(0)
  scannedSequence      Int          @default(0)
  version              Int          @default(0)
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, consumerKey])
  @@map("event_consumer_cursor")
}

model EventConsumerDelivery {
  id             String                      @id @default(cuid())
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consumerKey    String
  sequence       Int
  status         EventConsumerDeliveryStatus @default(pending)
  claimToken     String?
  leaseUntil     DateTime?
  attempts       Int                         @default(0)
  externalRef    String?
  error          Json?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([organizationId, consumerKey, sequence])
  @@index([organizationId, consumerKey, status, sequence], map: "event_consumer_delivery_scope_status_sequence_idx")
  @@map("event_consumer_delivery")
}
