{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["nitro", "oxlint"]
    },
    "apps/oss": {
      "entry": [
        "src/{router,server}.{ts,tsx}",
        "src/routes/**/*.{ts,tsx}",
        "**/*.{test,spec}.{ts,tsx,mjs}",
        "*.config.ts",
        "src/test-utils/artifact-runtime.ts",
        "tests/**/index.html",
        "tests/onboarding-v2/screenshots.html",
        "tests/**/*.config.ts",
        "tests/onboarding-v2/{fixture,screenshots,screenshots-mocks}.tsx",
        "tests/visual/auth/main.tsx",
        "tests/e2e/fixtures/waitlist-form.tsx",
        "tests/onboarding-v2/runtime-captures.ts",
        "tests/visual/render-qui61-pdf.tsx",
        "e2e/qui52{,-current}-capture.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "build/**/*.mjs", "e2e/**/*.{ts,mjs}", "tests/**/*.{ts,tsx}", "*.config.ts"],
      "vite": false,
      "prisma": false,
      "playwright": false,
      "vitest": false,
      "ignoreDependencies": ["qui56-baseline-onboarding", "qui56-baseline-welcome"],
      "ignoreIssues": {
        "src/components/ui/**": ["exports", "types"]
      }
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "scripts": {
      "entry": [
        "check-*.mjs",
        "record-motion{,.smoke}.mjs",
        "{i18n-*,update-tm-allowlist,predev-bootstrap,prepare-number-rollback,run-with-workspace-env}.mjs",
        "__tests__/**/*.test.{ts,mjs}"
      ],
      "project": ["**/*.{ts,js,mjs}"]
    }
  }
}
