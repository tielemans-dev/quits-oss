DATABASE_URL=""
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32-plus-char-secret"
BETTER_AUTH_URL=""
# Comma-separated literal IPs/CIDRs of reverse proxies; empty ignores forwarding headers.
QUITS_AUTH_TRUSTED_PROXIES=""
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""
# Email provider: resend (default) or smtp. SMTP requires the Node/Bun runtime.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Used only with EMAIL_PROVIDER=smtp. Leave authentication empty for a local relay.
SMTP_HOST=""
# Leave empty to use 587 with STARTTLS or 465 when SMTP_SECURE=true.
SMTP_PORT=""
SMTP_SECURE="false"
# Require STARTTLS on port 587. Set false only for a trusted local plaintext relay.
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASS=""
# SMTP_PASSWORD is also accepted as a compatibility alias for SMTP_PASS.
FROM_EMAIL=""
# Bearer token for /api/cron/tick. The docker-compose scheduler service sends it every 5 minutes.
# Required: `docker compose up` refuses to start without it, and the cron endpoints answer 503
# while it is unset or still a placeholder such as "change-me-in-production".
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Persistent issued-document PDFs, relative to the self-host server working directory.
# YAIP_ARTIFACT_DIR is also accepted. Back up this directory with the database.
QUITS_ARTIFACT_DIR=./data/artifacts
