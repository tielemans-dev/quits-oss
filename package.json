{
  "name": "@quits/workspace",
  "version": "0.13.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "bun@1.3.9",
  "type": "module",
  "workspaces": [
    ".",
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "hooks:install": "lefthook install",
    "lint:staged": "bun scripts/lint-staged.mjs",
    "dev": "bun --filter @quits/oss dev",
    "prebuild": "bun --filter @quits/oss prisma:generate",
    "build": "QUITS_PRISMA_PREGENERATED=1 vp run --filter @quits/oss build",
    "preview": "bun --filter @quits/oss preview",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives apps/oss packages/contracts packages/shared scripts && node scripts/check-motion.mjs",
    "knip:report": "knip --config knip.json --no-exit-code",
    "pretypecheck": "bun --filter @quits/oss prisma:generate",
    "typecheck": "QUITS_PRISMA_PREGENERATED=1 vp run --filter \"@quits/*\" --filter \"!@quits/workspace\" typecheck",
    "pretypecheck:app": "bun --filter @quits/oss prisma:generate",
    "typecheck:app": "QUITS_PRISMA_PREGENERATED=1 bun --filter @quits/oss typecheck:app",
    "pretest": "bun --filter @quits/oss prisma:generate",
    "test": "QUITS_PRISMA_PREGENERATED=1 vp run --filter \"@quits/*\" --filter \"!@quits/workspace\" test",
    "test:e2e": "bun --filter @quits/oss test:e2e",
    "test:integration": "bun --filter @quits/oss test:integration",
    "db:start": "bun --filter @quits/oss db:start",
    "db:stop": "bun --filter @quits/oss db:stop",
    "db:logs": "bun --filter @quits/oss db:logs",
    "prisma:generate": "bun --filter @quits/oss prisma:generate",
    "prisma:migrate": "bun --filter @quits/oss prisma:migrate",
    "migrate": "bun --filter @quits/oss migrate",
    "i18n:check": "bun --filter @quits/oss i18n:check",
    "i18n:update-tm-allowlist": "bun --filter @quits/oss i18n:update-tm-allowlist",
    "test:e2e:shared": "bun --filter @quits/oss test:e2e:shared",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "nitro": "npm:nitro-nightly@3.0.1-20260309-141311-a2ee33b1",
    "typescript": "^5.7.2",
    "vite-plus": "1.0.0"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
