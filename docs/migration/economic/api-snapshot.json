 "executedProbes": {
  "note": "Read-only GET requests made on 2026-10-08 against the vendor's published public demo agreement (headers X-AppSecretToken: demo, X-AgreementGrantToken: demo, which the vendor documents as GET-only). This is a shared vendor demo company, not a customer account. No write method was sent. Only shapes and aggregate facts are recorded; no demo personal data is stored here.",
  "agreement": "vendor demo company (base currency DKK); plan level reported by /self as internal; the demo token presents SuperUser-equivalent read access, so it says nothing about narrower roles or paid plan gating",
  "probes": [
   {
    "id": "rest-self",
    "path": "/self",
    "status": 200
   },
   {
    "id": "rest-app-roles",
    "path": "/app-roles",
    "status": 200,
    "observed": "roles Sales(1), SuperUser(2), ProjectEmployee(3), Bookkeeping(4)"
   },
   {
    "id": "rest-accounting-years",
    "path": "/accounting-years",
    "status": 200,
    "observed": "year, fromDate, toDate, entries/vouchers/periods/totals links; no closed flag shown on the demo years"
   },
   {
    "id": "rest-customers",
    "path": "/customers?pagesize=3",
    "status": 200,
    "observed": "pagination object with maxPageSizeAllowed 1000 and first/next/last links; optional fields (vat number, CVR, EAN) are omitted when empty"
   },
   {
    "id": "rest-booked-invoices",
    "path": "/invoices/booked?pagesize=5",
    "status": 200,
    "observed": "6 booked invoices; every item carries pdf.download, remainder, remainderInBaseCurrency, roundingAmount; no field references an original invoice for credit notes"
   },
   {
    "id": "rest-booked-invoice-pdf",
    "path": "/invoices/booked/1/pdf",
    "status": 200,
    "observed": "content-type application/pdf, body starts with %PDF, response header x-callcost: 13"
   },
   {
    "id": "rest-entries-by-year",
    "path": "/accounting-years/2022/entries",
    "status": 200,
    "observed": "entries carry entryType as a string, voucherNumber, invoiceNumber and a bookedInvoice link"
   },
   {
    "id": "be-count",
    "path": "BookedEntries v6.0.0 /booked-entries/count",
    "status": 200,
    "observed": "138"
   },
   {
    "id": "be-list",
