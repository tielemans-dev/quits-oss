 "openapi": {
  "BookedEntries": {
   "version": "6.0.0",
   "baseUrl": "https://apis.e-conomic.com/bookedEntriesapi/v6.0.0/",
   "requiredRoles": [
    "Bookkeeping",
    "SuperUser"
   ],
   "endpoints": [
    {
     "method": "GET",
     "path": "/booked-entries",
     "operationId": "GetAllBookedEntries"
    },
    {
     "method": "GET",
     "path": "/booked-entries/paged",
     "operationId": "GetPageOfBookedEntries"
    },
    {
     "method": "GET",
     "path": "/booked-entries/count",
     "operationId": "GetNumberOfBookedEntries"
    },
    {
     "method": "POST",
     "path": "/booked-entries/match",
     "operationId": "MatchBookedEntries"
    },
    {
     "method": "GET",
     "path": "/booked-entries/matched-pairs",
     "operationId": "GetMatchedBookedEntries"
    }
   ],
   "schemas": {
    "BookedEntry": [
     "accountNumber",
     "amount",
     "amountInBaseCurrency",
     "costTypeNumber",
     "currencyCode",
     "customerInvoiceNumber",
     "customerNumber",
     "date",
     "dueDate",
     "entryNumber",
     "objectVersion",
     "projectNumber",
     "remainder",
     "supplierInvoiceNumber",
     "supplierNumber",
     "supplierPayment",
     "text",
     "type",
     "vatAccountNumber",
     "voucherNumber"
    ],
    "MatchedBookedEntriesPair": [
     "fromEntry",
     "fromEntryAmount",
     "fromEntryAmountDKK",
     "fromEntryDate",
     "toEntry",
     "toEntryAmount",
     "toEntryAmountDKK",
     "toEntryDate"
    ],
    "MatchedBookedEntriesPairCursorResults": [
     "cursor",
     "items"
    ],
    "BookedEntryCursorResults": [
     "cursor",
     "items"
    ]
   }
  },
  "Documents": {
   "version": "4.0.1",
   "baseUrl": "https://apis.e-conomic.com/documentsapi/v4.0.1/",
   "requiredRoles": [
    "Bookkeeping",
    "SuperUser"
   ],
   "endpoints": [
    {
     "method": "GET",
     "path": "/AttachedDocuments",
     "operationId": "GetAllAttachedDocuments"
    },
    {
     "method": "POST",
     "path": "/AttachedDocuments",
     "operationId": "AttachPdfAsync"
    },
    {
     "method": "GET",
     "path": "/AttachedDocuments/paged",
     "operationId": "GetPageOfAttachedDocuments"
    },
    {
     "method": "GET",
     "path": "/AttachedDocuments/count",
     "operationId": "GetNumberOfAttachedDocuments"
    },
    {
     "method": "GET",
     "path": "/AttachedDocuments/{number}",
     "operationId": "GetAttachedDocumentById"
    },
    {
     "method": "DELETE",
     "path": "/AttachedDocuments/{number}",
     "operationId": "DeleteAttachedDocumentById"
    },
    {
     "method": "GET",
     "path": "/AttachedDocuments/{number}/pdf",
     "operationId": "GetPdfForAttachedDocument"
    },
    {
     "method": "DELETE",
     "path": "/AttachedDocuments/deletebulk",
     "operationId": "BulkDeleteAttachedDocumentsByIds"
    }
   ],
   "schemas": {
    "AttachedDocument": [
     "accountingYear",
     "note",
     "number",
     "pageCount",
     "voucherNumber"
    ],
    "AttachedDocumentCursorResults": [
     "cursor",
     "items"
    ]
   }
  }
 },
